{
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "paths": {
      "react-native-usesense": ["./src/index"]
    }
  },
  "include": ["src"]
}

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Pinned to iOS 15.0 to match the react-native-usesense podspec floor, which in
# turn matches the UseSense iOS SDK's iOS 15 deployment target. RN 0.73's default
# `min_ios_version_supported` resolves to iOS 13.4, which is below the SDK floor
# and causes CocoaPods to fail dependency resolution for `react-native-usesense`.
platform :ios, '15.0'
prepare_react_native_project!

# If you are using a `react-native-flipper` your iOS build will fail when `NO_FLIPPER=1` is set.
# because `react-native-flipper` depends on (FlipperKit,...) that will be excluded
#
# To fix this you can also exclude `react-native-flipper` using a `react-native.config.js`
# ```js
# module.exports = {
#   dependencies: {
#     ...(process.env.NO_FLIPPER ? { 'react-native-flipper': { platforms: { ios: null } } } : {}),
# ```
flipper_config = ENV['NO_FLIPPER'] == "1" ? FlipperConfiguration.disabled : FlipperConfiguration.enabled

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'UseSenseExample' do
  config = use_native_modules!

  # INTERIM (white-label): the appearance/copy API the bridge calls
  # (FlowAppearance/FlowCopy + UseSenseFlows.run(appearance:copy:)) is on the iOS
  # SDK's main branch but NOT yet in a published CocoaPods release -- trunk's latest
  # is 4.4.1, which predates the white-label work. Track main so this example/CI
  # compiles the bridge against the API it targets. REMOVE once UseSenseSDK is
  # published WITH the appearance/copy API and the plugin podspec is bumped to that
  # version; until then a real consumer's `pod install` resolves the old trunk pod
  # and the bridge will not build.
  pod 'UseSenseSDK', :git => 'https://github.com/qudusadeyemi/usesense-ios-sdk.git', :branch => 'main'

  use_react_native!(
    :path => config[:reactNativePath],
    # Enables Flipper.
    #
    # Note that if you have use_frameworks! enabled, Flipper will not work and
    # you should disable the next line.
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'UseSenseExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end

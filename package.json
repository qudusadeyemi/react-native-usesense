{
  "name": "react-native-usesense",
  "version": "1.0.0",
  "description": "React Native plugin for human presence verification. Wraps the native UseSense iOS and Android SDKs.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-usesense.podspec",
    "README.md",
    "LICENSE",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "prepare": "bob build",
    "clean": "del-cli lib"
  },
  "keywords": [
    "react-native",
    "usesense",
    "identity-verification",
    "kyc",
    "aml",
    "liveness",
    "biometric",
    "face-verification",
    "deepfake-detection",
    "presence-verification",
    "turbo-module"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qudusadeyemi/react-native-usesense.git"
  },
  "homepage": "https://github.com/qudusadeyemi/react-native-usesense#readme",
  "bugs": {
    "url": "https://github.com/qudusadeyemi/react-native-usesense/issues"
  },
  "author": "UseSense Technologies Ltd.",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNUseSenseSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}

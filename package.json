{
  "name": "react-native-usesense",
  "version": "0.1.0",
  "description": "React Native wrapper for the UseSense iOS & Android SDKs — identity verification, liveness detection, and deduplication for mobile apps",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-usesense.podspec",
    "!android/build",
    "!ios/build",
    "!**/__tests__"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "prepare": "bob build",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "usesense",
    "identity-verification",
    "kyc",
    "liveness",
    "deepsense",
    "livesense",
    "dedupe",
    "face-verification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qudusadeyemi/react-native-usesense.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "react-native-builder-bob": "^0.30.0",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNUseSenseSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.usesense.reactnative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
